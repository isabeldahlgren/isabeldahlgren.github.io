:root{--ink:#222;--paper:#fff;--rule:#ddd;--muted:#888;--link:#2a5db0;--accent:#2a5db0;--serif:Times New Roman,Times,serif;--sans:Times New Roman,Times,serif}*,:after,:before{box-sizing:border-box;padding:0}html{background:var(--paper);-webkit-text-size-adjust:100%}body{margin:0;font:17px/1.45 times new roman,Times,serif;color:var(--ink);background:var(--paper);text-rendering:optimizeLegibility;font-kerning:normal}main{max-width:calc(34rem + 100px);margin:0 auto;padding:48px 50px 64px}@media(max-width:600px){main{padding:24px 18px 48px}}a{color:var(--link);text-decoration:none}a:hover{text-decoration:underline}::selection{background:#fff3b4}p{margin:1em 0}header{margin-bottom:2.5em}.site-nav{margin:0}.site-nav .here{color:var(--ink)}header+hr{display:none}h1,h2,h3,h4,h5,h6{font-family:times new roman,Times,serif;font-weight:600;line-height:1.25}section>h2[itemprop]{font-size:1.3rem;letter-spacing:-.01em;margin:0 0 .3rem}.meta{font-family:times new roman,Times,serif;font-size:.8rem;color:var(--muted);margin:0 0 2em}.meta a{color:inherit}[itemprop=articleBody] h2,[itemprop=articleBody] h3{font-size:1rem;margin:2em 0 .5em}[itemprop=articleBody] h4,[itemprop=articleBody] h5,[itemprop=articleBody] h6{font-size:.95rem;margin:1.5em 0 .4em}.hash{display:none}.intro-text p{margin-top:0}.posts{list-style:none;padding:0;margin:0}.posts li{display:flex;align-items:baseline;gap:1.2rem;margin:0 0 .35em}.posts li time{order:-1;flex:none;font-family:times new roman,Times,serif;font-size:.75rem;color:var(--muted);font-variant-numeric:tabular-nums}.posts hr{display:none}@media(max-width:480px){.posts li{flex-direction:column;gap:0;margin-bottom:.7em}}footer{margin-top:4em;font-size:.85rem;color:var(--muted)}footer ul{list-style:none;padding:0;margin:0}hr{border:0;height:1px;background:var(--rule)}ul,ol{padding-left:1.5em}li{margin:.3em 0}blockquote{border-left:1px solid var(--rule);margin:1em 0 1em 1.25em;padding-left:1em}code,pre{font-family:ui-monospace,sf mono,Menlo,Consolas,monospace;font-size:.85em}pre{overflow-x:auto;white-space:pre-wrap;padding:.8em 1em;background:#f6f6f6}img,video{max-width:100%;height:auto}table{border-collapse:collapse;font-size:.9em;font-variant-numeric:tabular-nums}table th,table td{padding:.3em 1em .3em 0;text-align:left;border-bottom:1px solid var(--rule)}.footnotes{font-size:.9em}sup{line-height:0}a.footnote-ref{font-family:times new roman,Times,serif;font-size:.72em;font-weight:600;padding:0 .1em}.sidenote{display:none}.has-sidenotes{position:relative}.sidenotes-wide .sidenote{display:block;position:absolute;left:calc(100% + 2.5rem);width:15rem;font-family:times new roman,Times,serif;font-size:.76rem;line-height:1.45;color:#555;transition:background-color .6s}.sidenotes-wide .footnotes{display:none}.sidenote p,.sidenote-inline p{margin:0}.sidenote p+p,.sidenote-inline p+p{margin-top:.4em}.sidenote-number{color:var(--link);font-weight:600;margin-right:.45em}.sidenote.flash{animation:sidenote-flash 1.2s ease-out}@keyframes sidenote-flash{from{background-color:#fff3b4}to{background-color:transparent}}.sidenote-inline{display:block;margin:.6em 0 1em;padding:.6em .8em;border-left:2px solid var(--link);background:#f7f7f7;font-family:times new roman,Times,serif;font-size:.82rem;line-height:1.45;color:#444}.footnotes{font-family:times new roman,Times,serif;font-size:.8rem;color:#555;margin-top:3em}.footnotes hr{width:4rem;margin:0 0 1em}.irreality-page main{max-width:1240px;padding:100px 60px 64px}.gallery-back{position:absolute;top:1.25rem;left:1.5rem}.gallery-intro{margin-bottom:5rem;text-align:center}.gallery-intro h1{font-size:1.5rem;font-weight:400;margin:0}.gallery-intro p{margin:.4rem 0 0;color:#666;font-size:1rem}.print-series{margin:0 0 7rem}.series-heading{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--rule);padding-bottom:.8rem;margin-bottom:3rem}.series-heading h2{font-size:1.15rem;font-weight:400;margin:0}.series-heading h2 a{color:var(--ink)}.series-heading span{color:#666;font-size:.9rem}.series-description{max-width:34rem;margin:-1rem 0 3rem}.print-wall{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3.5rem 3rem}.print{margin:0;min-width:0}.print-open{display:flex;align-items:center;justify-content:center;height:310px;padding:18px}.print-open img{display:block;width:auto;height:auto;max-width:100%;max-height:100%;box-shadow:0 2px 8px #00000012;transition:transform .2s ease}.print-open:hover img{transform:scale(1.025)}.print-open:focus-visible,.print-viewer button:focus-visible{outline:2px solid var(--link);outline-offset:5px}.print figcaption{text-align:center;color:#666;font-size:.875rem;margin-top:1.2rem}.viewing-print{overflow:hidden}.print-viewer{width:100vw;height:100dvh;max-width:none;max-height:none;border:0;padding:4.5rem 3rem 1.5rem;background:var(--paper);color:var(--ink)}.print-viewer[open]{display:flex;flex-direction:column;align-items:center}.print-viewer::backdrop{background:#fff}.print-viewer button{font:inherit;color:var(--link);background:0 0;border:0;padding:.5rem;cursor:pointer}.print-viewer button:disabled{color:#888;cursor:default}.viewer-close{position:absolute;right:1.5rem;top:1rem}.viewer-image{flex:1;min-height:0;width:100%;object-fit:contain}.viewer-caption{text-align:center;margin:1rem 0 .25rem}.viewer-title{margin:0}.viewer-position{font-size:.875rem;color:#666;margin:.3rem 0 0}.viewer-controls{display:flex;gap:2rem}@media(max-width:900px){.print-wall{grid-template-columns:repeat(2,minmax(0,1fr));gap:3rem 2rem}.irreality-page main{padding-left:30px;padding-right:30px}}@media(max-width:540px){.irreality-page main{padding:90px 24px 40px}.gallery-intro{margin-bottom:3.5rem}.print-wall{grid-template-columns:1fr;gap:3rem}.print-open{height:auto;padding:12px}.print-open img{max-height:65vh}.print-series{margin-bottom:5rem}.print-viewer{padding:4rem 16px 1rem}}@media(prefers-reduced-motion:reduce){.print-open img{transition:none}}.gallery-room,.room-heading,.room-series,.room-controls{display:none}.room-ready{background:#fff;color:#222}.room-ready main{max-width:none;height:100svh;min-height:520px;padding:0;overflow:hidden}.room-ready .gallery-intro{display:none}.room-ready .gallery-back{position:fixed;z-index:5;top:24px;left:28px}.gallery-disclosure{position:fixed;bottom:24px;right:28px;max-width:30%;text-align:right;margin:0;font-size:12px;color:#666;pointer-events:none}.room-ready .gallery-disclosure{z-index:4}.room-ready .gallery-room{display:block;position:absolute;inset:0;overflow:hidden;perspective:900px;perspective-origin:50% 50%;cursor:default;touch-action:none;background:#fff}.room-world{position:absolute;left:50%;top:50%;transform-style:preserve-3d;will-change:transform}.room-architecture,.room-ready .print-series,.room-ready .print-wall{position:absolute;inset:0;transform-style:preserve-3d}.room-ready .print-series{margin:0}.room-ready .series-heading,.room-ready .series-description{display:none}.room-ready .print-wall{display:block}.room-ready .print-series[hidden]{display:none}.room-surface{position:absolute;transform-origin:0 0;backface-visibility:hidden}.room-wall{background:#fff;border:1px solid #000}.room-wall::after{content:"";position:absolute;left:0;right:0;bottom:14px;border-top:1px solid #000}.room-floor{background:#fff;border:1px solid #000}.room-ready .print{position:absolute;top:0;left:0;width:300px;margin:0;transform-origin:0 0;backface-visibility:hidden}.room-ready .print-open{padding:14px;height:330px;background:#fff;border:1px solid #000;box-shadow:none;cursor:zoom-in}.room-ready .print-open img{width:auto;height:auto;max-width:100%;max-height:100%;box-shadow:none}.room-ready .print-open:hover img{transform:none}.room-ready .print-open:hover{outline:1px solid #000;outline-offset:5px}.room-ready .print figcaption{font:15px/1.25 times new roman,Times,serif;text-align:left;color:#444;width:230px;margin:24px 0 0}.room-ready .room-heading{display:block;position:fixed;top:20px;left:50%;transform:translateX(-50%);text-align:center;z-index:4;pointer-events:none}.room-heading h1{font-size:23px;font-weight:400;margin:0}.room-heading p{font-size:16px;margin:3px 0 0;color:#666}.room-ready .room-series{display:flex;position:fixed;z-index:5;top:24px;right:28px;gap:18px;max-width:35%;flex-wrap:wrap;justify-content:flex-end}.room-series button,.room-controls button{font:inherit;color:var(--link);background:0 0;border:0;cursor:pointer;padding:0}.room-series button[aria-pressed=true]{color:#222;text-decoration:underline;text-underline-offset:4px}.room-ready .room-controls{display:flex;position:fixed;z-index:5;bottom:20px;left:50%;transform:translateX(-50%);align-items:flex-end;gap:32px;font-size:14px}.room-pad{display:flex;flex-direction:column;align-items:center;gap:4px}.room-pad span{display:flex;gap:4px}.room-pad button{display:block;width:32px;height:30px;border:1px solid #ccc;background:#ffffffd9;color:#444}.room-controls button:active{background:#eee}.room-controls button{touch-action:none;user-select:none}@media(max-width:700px){.room-ready .gallery-back{top:18px;left:16px;font-size:14px}.room-ready .gallery-disclosure{bottom:10px;right:16px;max-width:45%}.room-ready .room-heading{top:16px}.room-ready .room-series{top:82px;left:16px;right:16px;max-width:none;justify-content:center;font-size:15px}.room-ready .room-controls{bottom:32px}}.print-artist,.print-writing{text-align:left;color:#222;font:18px/1.4 times new roman,Times,serif;overflow-wrap:anywhere}.print-artist h3{font:inherit;font-weight:700;margin:0 0 .25em}.artist-years{margin:0 0 1em}.print-artist p,.print-note p{margin:0 0 .8em}.print-artist p:last-child,.print-note p:last-child{margin-bottom:0}.print-poem{white-space:pre-wrap;margin-top:1em}.print-poem:first-child{margin-top:0}.work-read{display:block;font:inherit;background:0 0;border:none;padding:0;color:var(--link);cursor:pointer;margin-top:.4em}.room-ready .print{display:grid;width:300px;grid-template-columns:300px;column-gap:40px;align-items:start}.room-ready .print.has-artist{width:600px;grid-template-columns:300px 260px}.room-ready .print.has-writing{width:640px;grid-template-columns:300px 300px}.room-ready .print.has-artist.has-writing{width:940px;grid-template-columns:300px 260px 300px}.room-ready .print-open{grid-column:1;grid-row:1}.room-ready .print-caption{grid-column:1;grid-row:2}.room-ready .print-artist{grid-column:2;grid-row:1/span 2}.room-ready .print-writing{grid-column:2;grid-row:1/span 2}.room-ready .has-artist .print-writing{grid-column:3}.room-ready .print.text-only{width:380px;grid-template-columns:380px}.room-ready .print.text-only.has-artist{width:680px;grid-template-columns:380px 260px}.room-ready .text-only .print-writing{grid-column:1;grid-row:1}.room-ready .text-only .print-artist{grid-column:2}.viewer-content{display:flex;gap:3rem;width:100%;flex:1;min-height:0}.viewer-content .viewer-image{width:0;flex:1}.viewer-reading{flex:0 1 30rem;overflow:auto;padding:1rem}.viewer-reading .print-writing{margin-top:2rem}.viewer-reading .print-writing:first-child{margin-top:0}.viewer-text-only .viewer-content{justify-content:center}.viewer-text-only .viewer-reading{flex-basis:38rem}.viewer-image[hidden],.viewer-reading[hidden]{display:none}@media(max-width:700px){.viewer-content{flex-direction:column;overflow:auto;gap:1rem}.viewer-content .viewer-image{width:100%;flex:none;height:45vh}.viewer-reading{flex:none;overflow:visible;padding:1rem 0}}.room-view-hint{display:none}.room-ready .room-view-hint{display:block;position:fixed;bottom:24px;left:28px;z-index:4;margin:0;font-size:12px;color:#666;pointer-events:none}@media(max-width:700px){.room-ready .room-view-hint{bottom:10px;left:16px}}.room-ready .room-series[hidden]{display:none}.room-ready.room-touch main{height:100dvh;min-height:0}.room-ready .room-controls[hidden]{display:none}.room-touch .gallery-room{user-select:none;-webkit-user-select:none}.room-touch .print-open{-webkit-touch-callout:none}.room-touch .room-view-hint,.room-touch .gallery-disclosure{bottom:Max(16px,env(safe-area-inset-bottom))}@media(max-width:700px){.room-touch .room-heading{left:auto;right:16px;transform:none;text-align:right}.room-touch .room-heading p{font-size:14px}}.artwork-page main{max-width:1100px;padding:24px 20px}.artwork-detail{margin:2rem auto;text-align:center}.artwork-detail h1{font-size:1.15rem;font-weight:400;margin:0 0 1.25rem}#artwork-image{display:block;width:100%;height:auto;max-height:70svh;object-fit:contain;margin:0 auto}#artwork-image[hidden]{display:none}#artwork-reading{max-width:36rem;margin:1.5rem auto 0;text-align:left}.artwork-navigation{display:flex;justify-content:space-between;gap:1rem;padding-bottom:env(safe-area-inset-bottom)}.artwork-navigation [aria-disabled=true]{color:#888}