:root{--ink:#222;--paper:#fff;--rule:#ddd;--muted:#888;--link:#2a5db0;--accent:#2a5db0;--serif:Times New Roman,Times,serif;--sans:Times New Roman,Times,serif}*,:after,:before{box-sizing:border-box;padding:0}html{background:var(--paper);-webkit-text-size-adjust:100%}body{margin:0;font:17px/1.45 times new roman,Times,serif;color:var(--ink);background:var(--paper);text-rendering:optimizeLegibility;font-kerning:normal}main{max-width:calc(34rem + 100px);padding:48px 50px 64px}@media(max-width:600px){main{padding:24px 18px 48px}}a{color:var(--link);text-decoration:none}a:hover{text-decoration:underline}::selection{background:#fff3b4}p{margin:1em 0}header{margin-bottom:2.5em}.site-nav{margin:0}.site-nav .here{color:var(--ink)}header+hr{display:none}h1,h2,h3,h4,h5,h6{font-family:times new roman,Times,serif;font-weight:600;line-height:1.25}section>h2[itemprop]{font-size:1.3rem;letter-spacing:-.01em;margin:0 0 .3rem}.meta{font-family:times new roman,Times,serif;font-size:.8rem;color:var(--muted);margin:0 0 2em}.meta a{color:inherit}[itemprop=articleBody] h2,[itemprop=articleBody] h3{font-size:1rem;margin:2em 0 .5em}[itemprop=articleBody] h4,[itemprop=articleBody] h5,[itemprop=articleBody] h6{font-size:.95rem;margin:1.5em 0 .4em}.hash{display:none}.intro-text p{margin-top:0}.posts{list-style:none;padding:0;margin:0}.posts li{display:flex;align-items:baseline;gap:1.2rem;margin:0 0 .35em}.posts li time{order:-1;flex:none;font-family:times new roman,Times,serif;font-size:.75rem;color:var(--muted);font-variant-numeric:tabular-nums}.posts hr{display:none}@media(max-width:480px){.posts li{flex-direction:column;gap:0;margin-bottom:.7em}}footer{margin-top:4em;font-size:.85rem;color:var(--muted)}footer ul{list-style:none;padding:0;margin:0}hr{border:0;height:1px;background:var(--rule)}ul,ol{padding-left:1.5em}li{margin:.3em 0}blockquote{border-left:1px solid var(--rule);margin:1em 0 1em 1.25em;padding-left:1em}code,pre{font-family:ui-monospace,sf mono,Menlo,Consolas,monospace;font-size:.85em}pre{overflow-x:auto;white-space:pre-wrap;padding:.8em 1em;background:#f6f6f6}img,video{max-width:100%;height:auto}table{border-collapse:collapse;font-size:.9em;font-variant-numeric:tabular-nums}table th,table td{padding:.3em 1em .3em 0;text-align:left;border-bottom:1px solid var(--rule)}.footnotes{font-size:.9em}sup{line-height:0}a.footnote-ref{font-family:times new roman,Times,serif;font-size:.72em;font-weight:600;padding:0 .1em}.sidenote{display:none}.has-sidenotes{position:relative}.sidenotes-wide .sidenote{display:block;position:absolute;left:calc(100% + 2.5rem);width:15rem;font-family:times new roman,Times,serif;font-size:.76rem;line-height:1.45;color:#555;transition:background-color .6s}.sidenotes-wide .footnotes{display:none}.sidenote p,.sidenote-inline p{margin:0}.sidenote p+p,.sidenote-inline p+p{margin-top:.4em}.sidenote-number{color:var(--link);font-weight:600;margin-right:.45em}.sidenote.flash{animation:sidenote-flash 1.2s ease-out}@keyframes sidenote-flash{from{background-color:#fff3b4}to{background-color:transparent}}.sidenote-inline{display:block;margin:.6em 0 1em;padding:.6em .8em;border-left:2px solid var(--link);background:#f7f7f7;font-family:times new roman,Times,serif;font-size:.82rem;line-height:1.45;color:#444}.footnotes{font-family:times new roman,Times,serif;font-size:.8rem;color:#555;margin-top:3em}.footnotes hr{width:4rem;margin:0 0 1em}